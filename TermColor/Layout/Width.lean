import TermColor

/-!
# TermColor.Layout.Width: terminal display width

Width is measured from visible characters, never from rendered ANSI escapes. The policy is
deterministic: controls and combining marks occupy zero columns, common CJK and emoji ranges
occupy two columns, and ambiguous characters occupy one.
-/

namespace TermColor
namespace Layout

private def inRange (value lower upper : Nat) : Bool := lower ≤ value && value ≤ upper

private def inRanges (value : Nat) : List (Nat × Nat) → Bool
  | [] => false
  | (lower, upper) :: rest => inRange value lower upper || inRanges value rest

